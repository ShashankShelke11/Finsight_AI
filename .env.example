# ==============================================================================
# FinSight AI Configuration
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# Database Connection
# For production PostgreSQL with pgvector:
# DATABASE_URL=postgresql://finsight_user:finsight_secret@localhost:5432/finsight_db
# For local zero-dependency testing / development fallback:
DATABASE_URL=sqlite:///./finsight.db

# Vector Search & Embeddings
USE_MOCK_EMBEDDINGS=true
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
HYBRID_SEARCH_RRF_K=60
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5

# Agent & LLM Orchestration
# Set to 'local_mock' for offline testing or tests without API keys,
# or provide an API key for Google Gemini / OpenAI / Groq / Anthropic.
LLM_PROVIDER=local_mock
LLM_MODEL=gemini-1.5-pro
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Security & Limits
MAX_UPLOAD_SIZE_MB=50
MAX_QUERY_LENGTH=1000
MAX_RETRIES_PER_QUERY=2
AUDIT_LOG_ENABLED=true
